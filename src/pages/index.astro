---
import Layout from '../layouts/Layout.astro';

const projects = [
	{
		title: "Chessing",
		href: "https://chess.ing",
		external: true,
		desc: "A digital chess platform for kids, structured as a knowledge graph — every concept maps to its prerequisites and downstream variations. Co-founded the company and lead product. Currently $10K ARR with partnerships across three Bay Area chess clubs."
	},
	{
		title: "ML Research at IIIT-Hyderabad",
		href: "#",
		external: false,
		desc: "Industry partner to three labs at IIIT-Hyderabad working on chess pedagogy and learning measurement: Prof. Vishnu Sreekumar (CogSci), Prof. Anil Nelakanti (LTRC),and Prof. Vineet Gandhi (CVIT). My role is bridging product and research — translating what we see in users into questions worth answering."
	},
	{
		title: "Sub-30 5K AI Pacer",
		href: "/posts/sub-30-5k",
		external: true,
		desc: "Training an AI coach on my own running data. A Gemini-powered agent that ingests heart rate, sleep, and cycle-phase data to suggest pace and training volume — building femtech logic into plans that typically ignore the female biological clock. Started at 39:13 in February; now at 34:00; targeting sub-30."
	},
	{
		title: "glass snake",
		href: "/glass-snake.html",
		external: false,
		desc: "a hand-tracked ar snake game inspired by a 20ft python at kbr park and thousands of hours on nokia snake as a kid. built with claude fable."
	},
	{
		title: "Trippy Cat Dance",
		href: "/media/cat_dance_final.mp4",
		external: true,
		desc: "A side experiment in audio-reactive GPU visualization — custom 3D sprite sequences synced to music tempo via FBM noise fields and exponential beat decay."
	}
];
---

<Layout title="Hinduja Reddy">
	<script is:inline>
		(() => {
			try {
				const saved = localStorage.getItem('theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				const isDark = saved ? saved === 'dark' : prefersDark;
				if (isDark) document.documentElement.classList.add('dark');
			} catch (_) {}
		})();
	</script>

	<main class="page">
		<nav class="navbar">
			<a href="/" class="nav-brand">Hinduja Reddy</a>
			<div class="nav-right">
				<div class="nav-links">
					<a href="/" class="active">Home</a>
					<a href="/posts">Posts</a>
					<a href="/about">About</a>
				</div>
				<button id="theme-toggle" class="theme-btn" aria-label="Toggle theme">
					<svg class="sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.22" x2="5.64" y2="17.76"></line><line x1="18.36" y1="5.64" x2="19.78" y2="7.06"></line></svg>
					<svg class="moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
				</button>
			</div>
		</nav>

		<header class="profile-header">
			<div class="profile-avatar-box">
				<img src="/avatar.jpeg" alt="Hinduja Reddy" class="avatar" />
			</div>
			<div class="profile-text-box">
				<h1>Hi, I'm @hinduja.</h1>
				<p class="profile-bio-summary">
					Co-founder and product lead at <a href="https://chess.ing/" target="_blank" rel="noopener noreferrer" class="inline-link">Chessing</a> — scaling a knowledge-graph curriculum for kids. Bridging the gap between 0-1 product execution, mathematical rigor, and data-driven systems.
				</p>
				<div class="social-links-row">
					<a href="https://github.com/hinduja64" target="_blank" rel="noopener noreferrer">GitHub</a>
					<span class="dot-separator">·</span>
					<a href="https://x.com/hinduja_reddy_" target="_blank" rel="noopener noreferrer">X</a>
					<span class="dot-separator">·</span>
					<a href="https://linkedin.com" target="_blank" rel="noopener noreferrer">LinkedIn</a>
				</div>
			</div>
		</header>

		<hr class="section-divider" />

		<section class="posts-list-wrapper">
			{projects.map(p => (
				<article class="post-block">
					<h2 class="post-title">
						{p.external
							? <a href={p.href} target="_blank" rel="noopener noreferrer">{p.title} <span class="arrow">↗</span></a>
							: <a href={p.href}>{p.title}</a>
						}
					</h2>
					<p class="post-excerpt">{p.desc}</p>
				</article>
			))}
		</section>
	</main>
</Layout>

<script>
	const setupTheme = () => {
		const btn = document.getElementById('theme-toggle');
		btn?.addEventListener('click', () => {
			const isDark = document.documentElement.classList.toggle('dark');
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
		});
	};
	setupTheme();
	document.addEventListener('astro:after-swap', setupTheme);
</script>

<style is:global>
	:root {
		--bg: #fdfdfd;
		--text: #111;
		--meta: #666;
		--link: #0066cc;
		--border: #eaeaea;
		--selection-bg: #fff2a8;
		--selection-text: #111;
	}
	html.dark {
		--bg: #0e0e10;
		--text: #e8e8e8;
		--meta: #888;
		--link: #7cb9ff;
		--border: #2a2a2d;
		--selection-bg: #4a3a7a;
		--selection-text: #fff;
	}
	html, body {
		background: var(--bg);
		color: var(--text);
		transition: background 0.2s ease, color 0.2s ease;
	}
	::selection {
		background: var(--selection-bg);
		color: var(--selection-text);
	}
</style>

<style>
	.page { max-width: 650px; margin: 0 auto; padding: 40px 20px 80px; }
	.navbar { display: flex; justify-content: space-between; align-items: center; padding-bottom: 1.25rem; margin-bottom: 3.5rem; border-bottom: 1px solid var(--border); }
	.nav-brand { font-size: 1.15rem; font-weight: 700; text-decoration: none; color: var(--text); letter-spacing: -0.01em; }
	.nav-right { display: flex; align-items: center; gap: 1.5rem; }
	.nav-links { display: flex; gap: 1.25rem; }
	.nav-links a { text-decoration: none; color: var(--meta); font-size: 0.95rem; font-weight: 500; transition: color 0.15s ease; }
	.nav-links a:hover, .nav-links a.active { color: var(--text); }

	.theme-btn { background: none; border: none; color: var(--meta); cursor: pointer; padding: 4px; display: flex; align-items: center; justify-content: center; transition: color 0.15s ease; }
	.theme-btn:hover { color: var(--text); }
	.theme-btn .sun { display: block; }
	.theme-btn .moon { display: none; }
	:global(html.dark) .theme-btn .sun { display: none; }
	:global(html.dark) .theme-btn .moon { display: block; }

	.profile-header { display: flex; gap: 2rem; align-items: flex-start; margin-bottom: 2.5rem; }
	.profile-avatar-box { flex-shrink: 0; }
	.avatar { width: 110px; height: 110px; border-radius: 50%; object-fit: cover; display: block; }
	.profile-text-box { flex-grow: 1; }
	.profile-text-box h1 { font-size: 1.8rem; font-weight: 700; margin: 0 0 0.5rem 0; color: var(--text); letter-spacing: -0.02em; }
	.profile-bio-summary { margin: 0 0 1rem 0; color: var(--text); font-size: 1.02rem; line-height: 1.6; opacity: 0.85; }

	.inline-link {
		color: var(--link);
		text-decoration: none;
		font-weight: 500;
		background-image: linear-gradient(var(--link), var(--link));
		background-size: 0% 1px;
		background-position: 0 100%;
		background-repeat: no-repeat;
		transition: background-size 0.25s ease;
	}
	.inline-link:hover { background-size: 100% 1px; }

	.social-links-row { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; }
	.social-links-row a { color: var(--meta); text-decoration: none; transition: color 0.15s ease; }
	.social-links-row a:hover { color: var(--link); text-decoration: underline; }
	.dot-separator { color: var(--meta); user-select: none; }

	.section-divider {
		border: none;
		border-top: 1px solid var(--border);
		margin: 3rem 0 3rem;
	}

	.posts-list-wrapper { display: flex; flex-direction: column; gap: 2.5rem; }
	.post-block { transition: transform 0.18s ease; }
	.post-block:hover { transform: translateX(4px); }

	.post-title { font-size: 1.25rem; font-weight: 600; margin: 0 0 0.5rem 0; letter-spacing: -0.01em; }
	.post-title a { color: var(--link); text-decoration: none; transition: color 0.15s ease; }
	.post-title a:hover { text-decoration: underline; }
	.post-title .arrow {
		display: inline-block;
		font-weight: 400;
		transition: transform 0.15s ease;
	}
	.post-title a:hover .arrow { transform: translate(3px, -3px); }
	.post-excerpt { margin: 0; color: var(--text); font-size: 0.98rem; line-height: 1.6; opacity: 0.9; }

	@media (max-width: 560px) {
		.profile-header { flex-direction: column; gap: 1.25rem; align-items: center; text-align: center; }
		.social-links-row { justify-content: center; }
	}
</style>
