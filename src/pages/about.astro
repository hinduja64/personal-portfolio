---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About // Hinduja Reddy">
	<script is:inline>
		(() => {
			try {
				const saved = localStorage.getItem('theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				const isDark = saved ? saved === 'dark' : prefersDark;
				if (isDark) document.documentElement.classList.add('dark');
			} catch (_) {}
		})();
	</script>

	<main class="page">
		<nav class="navbar">
			<a href="/" class="nav-brand">Hinduja Reddy</a>
			<div class="nav-right">
				<div class="nav-links">
					<a href="/">Home</a>
					<a href="/posts">Posts</a>
					<a href="/about" class="active">About</a>
				</div>
				<button id="theme-toggle" class="theme-btn" aria-label="Toggle theme">
					<svg class="sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.22" x2="5.64" y2="17.76"></line><line x1="18.36" y1="5.64" x2="19.78" y2="7.06"></line></svg>
				<svg class="moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
				</button>
			</div>
		</nav>

		<h1 class="page-title">About</h1>

		<section class="about-content-layout">
			<div class="about-text-column">
				<p>I'm a self-taught engineer based in Hyderabad. I co-founded <a href="https://chess.ing/" target="_blank" rel="noopener noreferrer" class="inline-link">Chessing</a>, a chess platform for kids, where I lead product.</p>
				<p>The rest of my time goes into ML research with IIIT-Hyderabad faculty, and personal experiments on health and performance data.</p>
				<p>Two areas have my attention right now. <strong>Large language models</strong> — specifically how they reason about structured domains  and <strong>femtech</strong> — building digital solutions for female health conditions like PCOD, PCOS etc.</p>
			</div>
			<div class="about-image-column">
				<img src="/me_about.jpg" alt="Hinduja Reddy" class="about-profile-img" />
			</div>
		</section>

		<section class="contact-section">
			<p class="contact-line">
				Open to collaborations, chess content partnerships, and interesting conversations. Reach me on <a href="https://x.com/hinduja_reddy_" target="_blank" rel="noopener noreferrer" class="inline-link">X</a>.
			</p>
		</section>

		<section class="vault-section">
			<h2 class="vault-heading">Projects &amp; Artifacts</h2>
			<ul class="vault-links-list">
				<li>
					<a href="https://chess.ing" target="_blank" rel="noopener noreferrer">Chessing <span class="arrow">↗</span></a>
					<span class="vault-desc">— The live product. Chess platform for kids, structured as a knowledge graph.</span>
				</li>
				<li>
					<a href="/media/cat_dance_final.mp4" target="_blank" rel="noopener noreferrer">Trippy Cat Dance <span class="arrow">↗</span></a>
					<span class="vault-desc">— Audio-reactive GPU visualization. ~30s render.</span>
				</li>
				<li>
					<a href="https://github.com/hinduja64/sub-30-5k-predictor" target="_blank" rel="noopener noreferrer">Sub-30 5K Pacer <span class="arrow">↗</span></a>
					<span class="vault-desc">— Repo for the AI pacer experiment. Started Feb 2026 at 39:13; now 34:00.</span>
				</li>
			</ul>
		</section>
	</main>
</Layout>

<script>
	const setupTheme = () => {
		const btn = document.getElementById('theme-toggle');
		btn?.addEventListener('click', () => {
			const isDark = document.documentElement.classList.toggle('dark');
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
		});
	};
	setupTheme();
	document.addEventListener('astro:after-swap', setupTheme);
</script>

<style is:global>
	:root {
		--bg: #fdfdfd;
		--text: #111;
		--meta: #666;
		--link: #0066cc;
		--border: #eaeaea;
		--selection-bg: #fff2a8;
		--selection-text: #111;
	}
	html.dark {
		--bg: #0e0e10;
		--text: #e8e8e8;
		--meta: #888;
		--link: #7cb9ff;
		--border: #2a2a2d;
		--selection-bg: #4a3a7a;
		--selection-text: #fff;
	}
	html, body {
		background: var(--bg);
		color: var(--text);
		transition: background 0.2s ease, color 0.2s ease;
	}
	::selection {
		background: var(--selection-bg);
		color: var(--selection-text);
	}
</style>

<style>
	.page { max-width: 650px; margin: 0 auto; padding: 40px 20px 80px; }
	.navbar { display: flex; justify-content: space-between; align-items: center; padding-bottom: 1.25rem; margin-bottom: 3.5rem; border-bottom: 1px solid var(--border); }
	.nav-brand { font-size: 1.15rem; font-weight: 700; text-decoration: none; color: var(--text); letter-spacing: -0.01em; }
	.nav-right { display: flex; align-items: center; gap: 1.5rem; }
	.nav-links { display: flex; gap: 1.25rem; }
	.nav-links a { text-decoration: none; color: var(--meta); font-size: 0.95rem; font-weight: 500; transition: color 0.15s ease; }
	.nav-links a:hover, .nav-links a.active { color: var(--text); }

	.theme-btn { background: none; border: none; color: var(--meta); cursor: pointer; padding: 4px; display: flex; align-items: center; justify-content: center; transition: color 0.15s ease; }
	.theme-btn:hover { color: var(--text); }
	.theme-btn .sun { display: block; }
	.theme-btn .moon { display: none; }
	:global(html.dark) .theme-btn .sun { display: none; }
	:global(html.dark) .theme-btn .moon { display: block; }

	.page-title { font-size: 2.2rem; font-weight: 800; margin: 0 0 2rem 0; color: var(--text); letter-spacing: -0.02em; }

	.about-content-layout { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 2.5rem; margin-bottom: 3rem; align-items: start; }
	.about-text-column p { margin: 0 0 1.25rem 0; font-size: 1.05rem; line-height: 1.65; color: var(--text); opacity: 0.95; }
	.about-text-column strong { font-weight: 700; color: var(--text); opacity: 1; }

	.inline-link {
		color: var(--link);
		text-decoration: none;
		font-weight: 500;
		background-image: linear-gradient(var(--link), var(--link));
		background-size: 0% 1px;
		background-position: 0 100%;
		background-repeat: no-repeat;
		transition: background-size 0.25s ease;
	}
	.inline-link:hover { background-size: 100% 1px; }

	.about-image-column { position: sticky; top: 2rem; }
	.about-profile-img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 12px;
		display: block;
		border: 1px solid var(--border);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.about-profile-img:hover {
		transform: translateY(-3px);
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
	}

	.contact-section {
		margin: 0 0 3rem;
		padding: 1.25rem 1.5rem;
		border-left: 3px solid var(--link);
		background: color-mix(in srgb, var(--link) 5%, transparent);
		border-radius: 4px;
	}
	.contact-line { margin: 0; font-size: 1rem; line-height: 1.6; color: var(--text); opacity: 0.95; }

	.vault-section { border-top: 1px solid var(--border); padding-top: 2.5rem; }
	.vault-heading { font-size: 1.3rem; font-weight: 700; margin: 0 0 1.25rem 0; color: var(--text); letter-spacing: -0.01em; }
	.vault-links-list { padding: 0; margin: 0; list-style: none; display: flex; flex-direction: column; gap: 0.85rem; }
	.vault-links-list li { font-size: 1rem; line-height: 1.5; transition: transform 0.18s ease; }
	.vault-links-list li:hover { transform: translateX(4px); }
	.vault-links-list a { color: var(--link); text-decoration: none; font-weight: 600; transition: color 0.15s ease; }
	.vault-links-list a:hover { text-decoration: underline; }
	.vault-links-list .arrow {
		display: inline-block;
		font-weight: 400;
		transition: transform 0.15s ease;
	}
	.vault-links-list a:hover .arrow { transform: translate(3px, -3px); }
	.vault-desc { color: var(--text); opacity: 0.8; margin-left: 0.25rem; }

	@media (max-width: 580px) {
		.about-content-layout { grid-template-columns: 1fr; gap: 1.75rem; }
		.about-image-column { position: static; max-width: 260px; margin: 0 auto; order: -1; }
	}
</style>